local function createSkyButton(skyName, bk, dn, ft, lf, rt, up, starCount, sunSize, moonSize, posY)
	local sBtn = Instance.new("TextButton")
	sBtn.Size = UDim2.new(0.9, 0, 0, 35)
	sBtn.Position = UDim2.new(0.05, 0, 0, posY)
	sBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
	sBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	sBtn.TextSize = 14
	sBtn.Font = Enum.Font.SourceSans
	sBtn.Text = skyName
	sBtn.Parent = SkyFrame

	sBtn.MouseButton1Click:Connect(function()
		for _, v in ipairs(Lighting:GetChildren()) do
			if v:IsA("Sky") then v:Destroy() end
		end
		local sky = Instance.new("Sky")
		sky.Name = skyName
		sky.SkyboxBk = bk
		sky.SkyboxDn = dn
		sky.SkyboxFt = ft
		sky.SkyboxLf = lf
		sky.SkyboxRt = rt
		sky.SkyboxUp = up
		sky.StarCount = starCount or 3000
		sky.SunAngularSize = sunSize or 0
		sky.MoonAngularSize = moonSize or 0
		sky.Parent = Lighting
	end)
end

