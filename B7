-- كود تشغيل وتطبيق سكريبت دسك (Dusk) للأنيميشن بدون صوت
local function hookChar(c)
	local h = c:WaitForChild("Humanoid", 5)
	if not h then return end
	h.AnimationPlayed:Connect(function(t)
		if not actDusk then return end
		local id = tostring(t.Animation.AnimationId):lower()
		local nm = tostring(t.Name):lower()
		if nm:find("throw") or nm:find("stab") or nm:find("slash") or id:find("throw") or id:find("247206411") then 
			return 
		end
		if id:find("reload") or nm:find("reload") or nm:find("recarga") or id:find("3400611413") or id:find("3400610059") or t.Priority == Enum.AnimationPriority.Action then 
			t:Stop()
		end
	end)
end
if localPlayer.Character then hookChar(localPlayer.Character) end
localPlayer.CharacterAdded:Connect(hookChar)


